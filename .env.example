# ─── Postgres ────────────────────────────────────────────────────────────────
# No Railway: use o plugin PostgreSQL — ele injeta DATABASE_URL automaticamente.
# Em dev local com Docker: preencha as variáveis abaixo.
POSTGRES_USER=ping
POSTGRES_PASSWORD=ping
POSTGRES_DB=ping
# DATABASE_URL é gerado pelo Railway; em dev o docker-compose monta ele.
# DATABASE_URL=postgresql+psycopg2://ping:ping@db:5432/ping

# ─── Backend ─────────────────────────────────────────────────────────────────
JWT_SECRET=troque-este-segredo-em-producao
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=*

# ─── Firebase ────────────────────────────────────────────────────────────────
# OPÇÃO 1 — Railway (env var com o conteúdo do JSON em uma linha):
#   1. Abra o firebase-credentials.json
#   2. Minifique (remova quebras de linha): python -c "import json,sys; print(json.dumps(json.load(open('firebase-credentials.json'))))"
#   3. Cole o resultado abaixo
FIREBASE_CREDENTIALS_JSON=

# OPÇÃO 2 — Docker local com arquivo montado (não usar no Railway):
FIREBASE_CREDENTIALS_PATH=/app/firebase-credentials.json
